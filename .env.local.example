# Copia este archivo a .env.local (ignorado por git) y completa los valores.
# NUNCA pegues las claves reales aquí: este archivo SÍ se sube a git.

# Supabase — https://supabase.com/dashboard/project/<ref>/settings/api
# La URL es https://<ref>.supabase.co (no la URL del dashboard).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: NUNCA exponer al navegador. Solo la usa el servidor
# (webhook de retorno de n8n, reintentos de informes, código del staff).
SUPABASE_SERVICE_ROLE_KEY=

# n8n: flujo que genera los informes de IA. Sin la URL, los informes quedan pendientes.
N8N_AI_REPORT_WEBHOOK_URL=
AI_REPORT_WEBHOOK_SECRET=

# Correo de Supabase Auth (Send Email Hook → /api/webhooks/correo-auth → Gmail API).
# Secreto del hook: Supabase → Authentication → Hooks → Send Email (formato v1,whsec_...).
SEND_EMAIL_HOOK_SECRET=
# Cliente OAuth del proyecto de Google Cloud en la organización UMG (app interna,
# permiso gmail.send). El refresh token se saca con OAuth Playground.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Cuenta que autorizó el refresh token; es el remitente de los correos.
GMAIL_REMITENTE=

# Turnstile (opcional): site key del widget de Cloudflare. Sin ella se usa la de producción.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
