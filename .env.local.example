# Copia este archivo a .env.local (ignorado por git) y completa los valores.
# NUNCA pegues las claves reales aquí: este archivo SÍ se sube a git.

# Supabase — https://supabase.com/dashboard/project/<ref>/settings/api
# La URL es https://<ref>.supabase.co (no la URL del dashboard).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: NUNCA exponer al navegador. Solo la usan Route Handlers
# de servidor (p. ej. el webhook de retorno de n8n hacia ai_reports).
SUPABASE_SERVICE_ROLE_KEY=

# n8n — flujo de generación de informes de IA (módulo 5, Sprint 4).
# Mientras no exista instancia de n8n, generateAttentionReport() puede
# mockearse sin depender de estas variables.
N8N_AI_REPORT_WEBHOOK_URL=
AI_REPORT_WEBHOOK_SECRET=
